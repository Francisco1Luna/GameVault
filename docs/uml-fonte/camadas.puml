@startuml
skinparam classAttributeIconSize 0
skinparam dpi 140
skinparam nodesep 25
skinparam ranksep 55
skinparam shadowing false
skinparam linetype ortho
skinparam ArrowColor #181818
skinparam ArrowFontSize 11
skinparam PackageBorderColor #000000
skinparam PackageBackgroundColor #FFFFFF
skinparam NoteBackgroundColor #FFFFFF
skinparam NoteBorderColor #181818
skinparam class {
  BackgroundColor #F1F1F1
  BorderColor #181818
}
skinparam enum {
  BackgroundColor #F1F1F1
  BorderColor #181818
}
skinparam abstract {
  BackgroundColor #F1F1F1
  BorderColor #181818
}
skinparam interface {
  BackgroundColor #F1F1F1
  BorderColor #181818
}
title GameVault - Arquitetura em camadas (negocio e dados) - padrao Singleton

package dados {
  interface IRepositorioPlataformas {
    +salvar(Plataforma): Plataforma
    +atualizar(Plataforma)
    +remover(Long): boolean
    +buscarPorId(Long): Optional<Plataforma>
    +listar(): List<Plataforma>
  }
  interface IRepositorioJogos {
    +salvar(Jogo): Jogo
    +atualizar(Jogo)
    +remover(Long): boolean
    +buscarPorId(Long): Optional<Jogo>
    +listar(): List<Jogo>
  }
  interface IRepositorioClientes {
    +salvar(Cliente): Cliente
    +atualizar(Cliente)
    +remover(Long): boolean
    +buscarPorId(Long): Optional<Cliente>
    +buscarPorCpf(String): Optional<Cliente>
    +listar(): List<Cliente>
  }
  interface IRepositorioAlugueis {
    +salvar(Aluguel): Aluguel
    +atualizar(Aluguel)
    +buscarPorId(Long): Optional<Aluguel>
    +listarPorCliente(Cliente): List<Aluguel>
    +listar(): List<Aluguel>
  }
  interface IRepositorioVendas {
    +salvar(Venda): Venda
    +buscarPorId(Long): Optional<Venda>
    +listarPorCliente(Cliente): List<Venda>
    +listar(): List<Venda>
  }
  class RepositoriosPlataformas <<Singleton>> {
    {static} -INSTANCIA: RepositoriosPlataformas
    -RepositoriosPlataformas()
    {static} +getInstance(): RepositoriosPlataformas
    -plataformas: List<Plataforma>
    -proximoId: long
  }
  class RepositorioJogosLista <<Singleton>> {
    {static} -INSTANCIA: RepositorioJogosLista
    -RepositorioJogosLista()
    {static} +getInstance(): RepositorioJogosLista
    -jogos: List<Jogo>
    -proximoId: long
  }
  class RepositorioClientesLista <<Singleton>> {
    {static} -INSTANCIA: RepositorioClientesLista
    -RepositorioClientesLista()
    {static} +getInstance(): RepositorioClientesLista
    -clientes: List<Cliente>
    -proximoId: long
  }
  class RepositorioAlugueisLista <<Singleton>> {
    {static} -INSTANCIA: RepositorioAlugueisLista
    -RepositorioAlugueisLista()
    {static} +getInstance(): RepositorioAlugueisLista
    -alugueis: List<Aluguel>
    -proximoId: long
  }
  class RepositorioVendasLista <<Singleton>> {
    {static} -INSTANCIA: RepositorioVendasLista
    -RepositorioVendasLista()
    {static} +getInstance(): RepositorioVendasLista
    -vendas: List<Venda>
    -proximoId: long
  }
}

package negocio {
  class PlataformaService <<Singleton>> {
    {static} -INSTANCIA: PlataformaService
    -PlataformaService()
    {static} +getInstance(): PlataformaService
    +cadastrar(Plataforma): Plataforma
    +atualizar(Plataforma)
    +remover(Long): boolean
    +buscarPorId(Long): Optional<Plataforma>
    +listar(): List<Plataforma>
  }
  class JogoService <<Singleton>> {
    {static} -INSTANCIA: JogoService
    -JogoService()
    {static} +getInstance(): JogoService
    +salvar(Jogo): Jogo
    +atualizar(Jogo)
    +remover(Long): boolean
    +buscarPorId(Long): Optional<Jogo>
    +buscarPorTitulo(String): List<Jogo>
    +listarPorGenero(String): List<Jogo>
    +listarPorPlataforma(Long): List<Jogo>
    +listar(): List<Jogo>
  }
  class ClienteService <<Singleton>> {
    {static} -INSTANCIA: ClienteService
    -ClienteService()
    {static} +getInstance(): ClienteService
    +salvar(Cliente): Cliente
    +atualizar(Cliente)
    +remover(Long): boolean
    +buscarPorId(Long): Optional<Cliente>
    +buscarPorCpf(String): Optional<Cliente>
    +listar(): List<Cliente>
  }
  class EstoqueService <<Singleton>> {
    {static} -INSTANCIA: EstoqueService
    -EstoqueService()
    {static} +getInstance(): EstoqueService
    +definirEstoque(Jogo, Plataforma, int)
    +adicionarExemplares(Jogo, Plataforma, int): int
    +removerExemplares(Jogo, Plataforma, int): int
    +consultarQuantidade(Jogo, Plataforma): int
    +estaDisponivel(Jogo, Plataforma): boolean
    +consultarDisponibilidade(Jogo): Map<Plataforma, Integer>
    +possuiAlgumaDisponibilidade(Jogo): boolean
  }
  class AuthService <<Singleton>> {
    {static} +PERCENTUAL_DESCONTO_ASSINANTE: double = 10.0
    {static} -INSTANCIA: AuthService
    -idUsuarioAtual: Long
    -AuthService()
    {static} +getInstance(): AuthService
    +cadastrar(nome, cpf, dataNascimento, email, telefone, senha, assinante): Cliente
    +login(cpf: String, senha: String): Cliente
    +logout()
    +getUsuarioAtual(): Optional<Cliente>
    +exigirUsuarioAtual(): Cliente
    +estaLogado(): boolean
    +usuarioAtualEhAssinante(): boolean
  }
  class FinanceiroService <<Singleton>> {
    {static} -INSTANCIA: FinanceiroService
    -FinanceiroService()
    {static} +getInstance(): FinanceiroService
    {static} +MULTA_DIARIA_PADRAO: double = 5.00
    -multaDiaria: double
    +calcularValorLocacao(Jogo, LocalDate, LocalDate): double
    +calcularPrecoVenda(Jogo, Cliente): double
    +calcularDiasDeAtraso(Aluguel, LocalDate): long
    +calcularMulta(Aluguel, LocalDate): double
    +registrarMulta(Aluguel): Optional<Penalidade>
    +consultarPendencias(Cliente): List<Penalidade>
    +calcularTotalPendente(Cliente): double
    +possuiPendencias(Cliente): boolean
  }
  class AluguelService <<Singleton>> {
    {static} -INSTANCIA: AluguelService
    -AluguelService()
    {static} +getInstance(): AluguelService
    +realizarLocacao(Jogo, Plataforma, LocalDate, LocalDate): Aluguel
  }
  class DevolucaoService <<Singleton>> {
    {static} -INSTANCIA: DevolucaoService
    -DevolucaoService()
    {static} +getInstance(): DevolucaoService
    +devolver(Aluguel, LocalDate)
  }
  class VendaService <<Singleton>> {
    {static} -INSTANCIA: VendaService
    -VendaService()
    {static} +getInstance(): VendaService
    +registrarVenda(List<ItemVenda>, LocalDate): Venda
    +buscarPorId(Long): Optional<Venda>
    +listarDoUsuarioAtual(): List<Venda>
    +listarPorCliente(Cliente): List<Venda>
    +listar(): List<Venda>
  }

}

' realizações (repositórios)
IRepositorioPlataformas <|.. RepositoriosPlataformas
IRepositorioJogos <|.. RepositorioJogosLista
IRepositorioClientes <|.. RepositorioClientesLista
IRepositorioAlugueis <|.. RepositorioAlugueisLista
IRepositorioVendas <|.. RepositorioVendasLista

' services -> repositórios e outros services
PlataformaService --> IRepositorioPlataformas
PlataformaService --> IRepositorioJogos
JogoService --> IRepositorioJogos
JogoService --> IRepositorioAlugueis
ClienteService --> IRepositorioClientes
ClienteService --> FinanceiroService
AuthService --> ClienteService
EstoqueService --> IRepositorioJogos
AluguelService --> EstoqueService
AluguelService --> IRepositorioAlugueis
AluguelService --> FinanceiroService
AluguelService --> AuthService : usuário atual
DevolucaoService --> EstoqueService
DevolucaoService --> IRepositorioAlugueis
DevolucaoService --> FinanceiroService
VendaService --> EstoqueService
VendaService --> IRepositorioVendas
VendaService --> FinanceiroService
VendaService --> AuthService : usuário atual

AluguelService ..> "ValidadorMestre" : valida (ver diagrama de validação)
note bottom of IRepositorioPlataformas
  Cada RepositorioXLista implementa as operações
  da sua interface com uma lista em memória
  (synchronized, ids gerados no próprio repositório).
end note


note as NSing
  Padrão Singleton (instância única em memória):
  todo repositório e todo service tem construtor privado,
  uma instância estática final criada na carga da classe
  e getInstance() público. Cada service recebe, pelo
  getInstance() dos colaboradores, as MESMAS instâncias
  dos repositórios (via interface) e dos outros services,
  então todos enxergam o mesmo conjunto de dados.
  A camada gui (Contexto) obtém os services só por getInstance().
  Venda e locação são sempre feitas pelo usuário atual
  (AuthService): sem login, são recusadas.
end note
@enduml

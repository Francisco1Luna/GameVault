<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Cabeçalho da tela + abas. Na aba Loja, compra e locação ficam em dois cards lado a lado. -->
<VBox spacing="12.0" styleClass="tela" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.LojaController">
   <children>
      <VBox styleClass="cabecalho-tela">
         <children>
            <Label styleClass="titulo-tela" text="Loja" />
            <Label fx:id="rotuloConta" styleClass="subtitulo-tela" text="Conta" />
         </children>
      </VBox>
      <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
         <tabs>
            <Tab text="Catálogo">
               <content>
                  <BorderPane>
                     <top>
                        <HBox alignment="CENTER_LEFT" spacing="10.0" BorderPane.alignment="CENTER">
                           <BorderPane.margin><Insets bottom="12.0" /></BorderPane.margin>
                           <children>
                              <TextField fx:id="campoPesquisaCatalogo" HBox.hgrow="ALWAYS" maxWidth="420.0" promptText="Pesquisar jogo ou plataforma" />
                              <Button mnemonicParsing="false" onAction="#aoAtualizar" text="Atualizar" />
                           </children>
                        </HBox>
                     </top>
                     <center>
                        <TableView fx:id="tabelaCatalogo">
                           <placeholder><Label text="Nenhum jogo disponível" /></placeholder>
                           <columns>
                              <TableColumn fx:id="colJogo" minWidth="60.0" prefWidth="240.0" reorderable="false" text="Jogo" />
                              <TableColumn fx:id="colPlataforma" minWidth="60.0" prefWidth="150.0" reorderable="false" text="Plataforma" />
                              <TableColumn fx:id="colPreco" minWidth="60.0" prefWidth="200.0" reorderable="false" text="Seu preço (compra)" />
                              <TableColumn fx:id="colDiaria" maxWidth="150.0" minWidth="60.0" prefWidth="110.0" reorderable="false" text="Locação/dia" />
                              <TableColumn fx:id="colEstoque" maxWidth="110.0" minWidth="60.0" prefWidth="80.0" reorderable="false" text="Estoque" />
                           </columns>
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                        </TableView>
                     </center>
                     <bottom>
                        <HBox spacing="16.0" BorderPane.alignment="CENTER">
                           <BorderPane.margin><Insets top="16.0" /></BorderPane.margin>
                           <children>
                              <!-- card de compra -->
                              <VBox styleClass="card" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label styleClass="titulo-card" text="Comprar" />
                                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                                       <children>
                                          <Label styleClass="rotulo-campo" text="Quantidade" />
                                          <Spinner fx:id="spinnerQuantidade" editable="true" prefWidth="90.0" />
                                          <Region HBox.hgrow="ALWAYS" />
                                          <Label fx:id="rotuloTotalCompra" styleClass="resumo-valor" text="Total da compra: -" />
                                          <Button fx:id="botaoComprar" mnemonicParsing="false" onAction="#aoComprar" styleClass="primario" text="Comprar" />
                                       </children>
                                    </HBox>
                                 </children>
                              </VBox>
                              <!-- card de locação -->
                              <VBox styleClass="card" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label styleClass="titulo-card" text="Alugar" />
                                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                                       <children>
                                          <Label styleClass="rotulo-campo" text="Dias de locação" />
                                          <Spinner fx:id="spinnerDias" editable="true" prefWidth="90.0" />
                                          <Region HBox.hgrow="ALWAYS" />
                                          <Label fx:id="rotuloTotalLocacao" styleClass="resumo-valor" text="Total da locação: -" />
                                          <Button fx:id="botaoAlugar" mnemonicParsing="false" onAction="#aoAlugar" styleClass="primario" text="Alugar" />
                                       </children>
                                    </HBox>
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                     </bottom>
                  </BorderPane>
               </content>
            </Tab>
            <Tab text="Minhas compras">
               <content>
                  <TableView fx:id="tabelaCompras">
                     <placeholder><Label text="Você ainda não fez nenhuma compra" /></placeholder>
                     <columns>
                        <TableColumn fx:id="colCompraData" maxWidth="130.0" minWidth="60.0" prefWidth="100.0" reorderable="false" text="Data" />
                        <TableColumn fx:id="colCompraItens" minWidth="60.0" prefWidth="500.0" reorderable="false" text="Itens" />
                        <TableColumn fx:id="colCompraTotal" maxWidth="160.0" minWidth="60.0" prefWidth="120.0" reorderable="false" text="Total" />
                     </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
               </content>
            </Tab>
            <Tab text="Minhas locações">
               <content>
                  <BorderPane>
                     <center>
                        <TableView fx:id="tabelaLocacoes">
                           <placeholder><Label text="Você não tem locações" /></placeholder>
                           <columns>
                              <TableColumn fx:id="colLocJogo" minWidth="60.0" prefWidth="220.0" reorderable="false" text="Jogo" />
                              <TableColumn fx:id="colLocPlataforma" minWidth="60.0" prefWidth="140.0" reorderable="false" text="Plataforma" />
                              <TableColumn fx:id="colLocInicio" maxWidth="140.0" minWidth="60.0" prefWidth="110.0" reorderable="false" text="Retirada" />
                              <TableColumn fx:id="colLocPrazo" maxWidth="140.0" minWidth="60.0" prefWidth="110.0" reorderable="false" text="Devolver até" />
                              <TableColumn fx:id="colLocStatus" maxWidth="150.0" minWidth="60.0" prefWidth="110.0" reorderable="false" text="Status" />
                              <TableColumn fx:id="colLocValor" maxWidth="140.0" minWidth="60.0" prefWidth="100.0" reorderable="false" text="Valor" />
                              <TableColumn fx:id="colLocMulta" maxWidth="140.0" minWidth="60.0" prefWidth="100.0" reorderable="false" text="Multa" />
                           </columns>
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                        </TableView>
                     </center>
                     <bottom>
                        <HBox alignment="CENTER_RIGHT" spacing="8.0" BorderPane.alignment="CENTER">
                           <BorderPane.margin><Insets top="12.0" /></BorderPane.margin>
                           <children>
                              <Button fx:id="botaoDevolver" mnemonicParsing="false" onAction="#aoDevolver" styleClass="primario" text="Devolver selecionada" />
                           </children>
                        </HBox>
                     </bottom>
                  </BorderPane>
               </content>
            </Tab>
         </tabs>
      </TabPane>
   </children>
</VBox>

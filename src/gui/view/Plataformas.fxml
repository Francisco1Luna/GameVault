<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="489.0" prefWidth="512.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.PlataformasController">
   <top>
      <HBox spacing="8.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
         </padding>
         <children>
            <TextField fx:id="campoPesquisa" promptText="Pesquisar plataforma ou fabricante" HBox.hgrow="ALWAYS" />
         </children>
      </HBox>
   </top>
   <center>
      <TableView fx:id="tabelaPlataformas" BorderPane.alignment="CENTER">
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
         <columns>
            <TableColumn fx:id="colId" maxWidth="80.0" minWidth="40.0" prefWidth="58.0" text="ID" />
            <TableColumn fx:id="colNome" prefWidth="222.0" text="Nome" />
            <TableColumn fx:id="colFabricante" prefWidth="231.0" text="Fabricante" />
         </columns>
      </TableView>
   </center>
   <bottom>
      <HBox spacing="8.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
         </padding>
         <children>
            <TextField fx:id="campoNome" alignment="CENTER" promptText="Nome da plataforma" HBox.hgrow="ALWAYS" />
            <TextField fx:id="campoFabricante" alignment="CENTER" promptText="Fabricante" HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#aoAdicionar" text="Adicionar" textFill="#00ae00">
               <font>
                  <Font name="Consolas Italic" size="12.0" />
               </font>
            </Button>
            <Button mnemonicParsing="false" onAction="#aoEditar" text="Salvar alterações" />
            <Button mnemonicParsing="false" onAction="#aoRemover" text="Remover" textFill="RED" />
         </children>
      </HBox>
   </bottom>
</BorderPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Layout: cabeçalho + pesquisa em cima, tabela no centro, formulário em card à direita -->
<BorderPane styleClass="tela" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.PlataformasController">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="16.0">
         <BorderPane.margin><Insets bottom="16.0" /></BorderPane.margin>
         <children>
            <VBox styleClass="cabecalho-tela" HBox.hgrow="ALWAYS">
               <children>
                  <Label styleClass="titulo-tela" text="Plataformas" />
                  <Label styleClass="subtitulo-tela" text="Consoles e plataformas disponíveis no catálogo" />
               </children>
            </VBox>
            <TextField fx:id="campoPesquisa" prefWidth="320.0" promptText="Pesquisar plataforma ou fabricante" />
         </children>
      </HBox>
   </top>
   <center>
      <TableView fx:id="tabelaPlataformas" BorderPane.alignment="CENTER">
         <placeholder><Label text="Nenhuma plataforma encontrada" /></placeholder>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
         <columns>
            <TableColumn fx:id="colId" maxWidth="60.0" minWidth="45.0" prefWidth="45.0" reorderable="false" text="ID" />
            <TableColumn fx:id="colNome" minWidth="60.0" prefWidth="250.0" reorderable="false" text="Nome" />
            <TableColumn fx:id="colFabricante" minWidth="60.0" prefWidth="250.0" reorderable="false" text="Fabricante" />
         </columns>
      </TableView>
   </center>
   <right>
      <VBox maxHeight="-Infinity" prefWidth="360.0" styleClass="card" BorderPane.alignment="TOP_CENTER">
         <BorderPane.margin><Insets left="16.0" /></BorderPane.margin>
         <children>
            <Label styleClass="titulo-card" text="Dados da plataforma" />
            <Label styleClass="dica" text="Selecione uma linha da tabela para editar." wrapText="true" />
            <Label styleClass="rotulo-campo" text="Nome" />
            <TextField fx:id="campoNome" maxWidth="Infinity" promptText="Nome da plataforma" />
            <Label styleClass="rotulo-campo" text="Fabricante" />
            <TextField fx:id="campoFabricante" maxWidth="Infinity" promptText="Fabricante" />
            <HBox spacing="8.0">
               <VBox.margin><Insets top="8.0" /></VBox.margin>
               <children>
                  <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#aoAdicionar" styleClass="primario" text="Adicionar" HBox.hgrow="ALWAYS" />
                  <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#aoEditar" text="Salvar alterações" HBox.hgrow="ALWAYS" />
               </children>
            </HBox>
            <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#aoRemover" styleClass="perigo" text="Remover" />
         </children>
      </VBox>
   </right>
</BorderPane>

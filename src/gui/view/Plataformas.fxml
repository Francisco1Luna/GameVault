<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane prefHeight="489.0" prefWidth="512.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.PlataformasController">
   <top><HBox spacing="8.0"><padding><Insets bottom="8.0" left="12.0" right="12.0" top="8.0" /></padding><children><TextField fx:id="campoPesquisa" promptText="Pesquisar plataforma ou fabricante" HBox.hgrow="ALWAYS" /></children></HBox></top>
   <center>
      <TableView fx:id="tabelaPlataformas" BorderPane.alignment="CENTER">
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
         <columns>
            <TableColumn fx:id="colId" maxWidth="80.0" minWidth="40.0" prefWidth="58.0" text="ID" />
            <TableColumn fx:id="colNome" prefWidth="222.0" text="Nome" />
            <TableColumn fx:id="colFabricante" prefWidth="231.0" text="Fabricante" />
         </columns>
      </TableView>
   </center>
   <bottom>
      <GridPane hgap="10.0" vgap="8.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
         </padding>
         <columnConstraints>
            <ColumnConstraints hgrow="NEVER" minWidth="80.0" />
            <ColumnConstraints hgrow="ALWAYS" />
         </columnConstraints>
         <children>
            <Label text="Nome" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="campoNome" maxWidth="Infinity" promptText="Nome da plataforma" GridPane.columnIndex="1" GridPane.rowIndex="0" />

            <Label text="Fabricante" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <TextField fx:id="campoFabricante" maxWidth="Infinity" promptText="Fabricante" GridPane.columnIndex="1" GridPane.rowIndex="1" />

            <HBox spacing="8.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
               <children>
                  <Button mnemonicParsing="false" onAction="#aoAdicionar" styleClass="primario" text="Adicionar" />
                  <Button mnemonicParsing="false" onAction="#aoEditar" text="Salvar alterações" />
                  <Button mnemonicParsing="false" onAction="#aoRemover" styleClass="perigo" text="Remover" />
               </children>
            </HBox>
         </children>
      </GridPane>
   </bottom>
</BorderPane>

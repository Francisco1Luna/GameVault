<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<TabPane prefHeight="400.0" prefWidth="600.0" tabClosingPolicy="UNAVAILABLE" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.RelatoriosController">
    <tabs>
        <Tab text="Mais locados">
            <content>
                <BorderPane>
                    <top>
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <padding><Insets bottom="8.0" left="8.0" right="8.0" top="8.0" /></padding>
                            <children>
                                <Label text="De" />
                                <DatePicker fx:id="campoInicio" prefWidth="130.0" />
                                <Label text="até" />
                                <DatePicker fx:id="campoFim" prefWidth="130.0" />
                                <Button mnemonicParsing="false" onAction="#aoGerarMaisLocados" text="Gerar" />
                                <Button mnemonicParsing="false" onAction="#aoExportarCsv" text="Exportar CSV" />
                            </children>
                        </HBox>
                    </top>
                    <center>
                        <TableView fx:id="tabelaMaisLocados">
                            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                            <columns>
                                <TableColumn fx:id="colPosicao" prefWidth="50.0" text="#" />
                                <TableColumn fx:id="colJogoLocado" prefWidth="250.0" text="Jogo" />
                                <TableColumn fx:id="colGeneroLocado" prefWidth="150.0" text="Gênero" />
                                <TableColumn fx:id="colQuantidade" prefWidth="100.0" text="Locações" />
                            </columns>
                        </TableView>
                    </center>
                </BorderPane>
            </content>
        </Tab>
        <Tab text="Receita mensal">
            <content>
                <BorderPane>
                    <center>
                        <TableView fx:id="tabelaReceita">
                            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                            <columns>
                                <TableColumn fx:id="colMes" prefWidth="100.0" text="Mês" />
                                <TableColumn fx:id="colReceitaLocacoes" prefWidth="150.0" text="Locações" />
                                <TableColumn fx:id="colReceitaVendas" prefWidth="150.0" text="Vendas" />
                                <TableColumn fx:id="colReceitaTotal" prefWidth="150.0" text="Total" />
                            </columns>
                        </TableView>
                    </center>
                </BorderPane>
            </content>
        </Tab>
        <Tab text="Importados por gênero">
            <content>
                <BorderPane>
                    <top>
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <padding><Insets bottom="8.0" left="8.0" right="8.0" top="8.0" /></padding>
                            <children>
                                <Label text="Gênero" />
                                <ComboBox fx:id="campoGenero" onAction="#aoFiltrarGenero" prefWidth="200.0" />
                            </children>
                        </HBox>
                    </top>
                    <center>
                        <TableView fx:id="tabelaImportados">
                            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                            <columns>
                                <TableColumn fx:id="colTitulo" prefWidth="250.0" text="Título" />
                                <TableColumn fx:id="colGenero" prefWidth="150.0" text="Gênero" />
                                <TableColumn fx:id="colDesenvolvedora" prefWidth="180.0" text="Desenvolvedora" />
                            </columns>
                        </TableView>
                    </center>
                </BorderPane>
            </content>
        </Tab>
    </tabs>
</TabPane>

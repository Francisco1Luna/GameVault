<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.JogosController">
    <center>
        <TableView fx:id="tabelaJogos" BorderPane.alignment="CENTER">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="colId" maxWidth="60.0" minWidth="35.0" prefWidth="38.0" text="ID" />
                <TableColumn fx:id="colTitulo" prefWidth="144.0" text="Título" />
                <TableColumn fx:id="colGenero" prefWidth="120.0" text="Gênero" />
                <TableColumn fx:id="colPreco" prefWidth="80.0" text="Preço" />
                <TableColumn fx:id="colLocacao" prefWidth="90.0" text="Locação/dia" />
                <TableColumn fx:id="colPlataformas" prefWidth="140.0" text="Plataformas" />
            </columns>
        </TableView>
    </center>
    <bottom>
        <VBox spacing="8.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
            </padding>
            <children>
                <HBox spacing="8.0">
                    <children>
                        <TextField fx:id="campoTitulo" promptText="Título" HBox.hgrow="ALWAYS" />
                        <TextField fx:id="campoGenero" promptText="Gênero" HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>
                <HBox spacing="8.0">
                    <children>
                        <ComboBox fx:id="comboClassificacao" prefWidth="160.0" promptText="Classificação" />
                        <ListView fx:id="listaPlataformas" prefHeight="80.0" prefWidth="200.0" />
                        <TextField fx:id="campoEstoque" promptText="Estoque (vazio = manter)" HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>
                <HBox spacing="8.0">
                    <children>
                        <TextField fx:id="campoPreco" promptText="Preço" HBox.hgrow="ALWAYS" />
                        <TextField fx:id="campoLocacao" promptText="Locação por dia" HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#aoAdicionar" text="Adicionar" />
                        <Button mnemonicParsing="false" onAction="#aoRemover" text="Remover" />
                        <Button mnemonicParsing="false" onAction="#aoEditar" text="Salvar alterações" />
                        <Button mnemonicParsing="false" onAction="#aoAjustarEstoque" text="Ajustar estoque" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </bottom>
</BorderPane>
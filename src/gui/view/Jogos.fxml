<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.JogosController">
    <center>
        <TableView fx:id="tabelaJogos" BorderPane.alignment="CENTER">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="colId" maxWidth="60.0" minWidth="35.0" prefWidth="38.0" text="ID" />
                <TableColumn fx:id="colTitulo" prefWidth="144.0" text="Título" />
                <TableColumn fx:id="colGenero" prefWidth="120.0" text="Gênero" />
                <TableColumn fx:id="colPreco" prefWidth="80.0" text="Preço" />
                <TableColumn fx:id="colLocacao" prefWidth="90.0" text="Locação/dia" />
                <TableColumn fx:id="colPlataformas" prefWidth="140.0" text="Plataformas" />
            </columns>
        </TableView>
    </center>
    <bottom>
        <GridPane hgap="10.0" vgap="8.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
            </padding>
            <columnConstraints>
                <ColumnConstraints hgrow="NEVER" minWidth="90.0" />
                <ColumnConstraints hgrow="ALWAYS" />
                <ColumnConstraints hgrow="NEVER" minWidth="90.0" />
                <ColumnConstraints hgrow="ALWAYS" />
            </columnConstraints>
            <children>
                <Label text="Título" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="campoTitulo" maxWidth="Infinity" promptText="Título do jogo" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                <Label text="Gênero" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                <TextField fx:id="campoGenero" maxWidth="Infinity" promptText="Gênero" GridPane.columnIndex="3" GridPane.rowIndex="0" />

                <Label text="Preço" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <TextField fx:id="campoPreco" maxWidth="Infinity" promptText="Ex.: 199,90" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                <Label text="Locação/dia" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                <TextField fx:id="campoLocacao" maxWidth="Infinity" promptText="Ex.: 9,90" GridPane.columnIndex="3" GridPane.rowIndex="1" />

                <Label text="Classificação" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <ComboBox fx:id="comboClassificacao" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                <Label text="Estoque" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                <TextField fx:id="campoEstoque" maxWidth="Infinity" promptText="Vazio = manter" GridPane.columnIndex="3" GridPane.rowIndex="2" />

                <Label text="Plataformas" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                <ListView fx:id="listaPlataformas" prefHeight="90.0" GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="3" />

                <HBox spacing="8.0" GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="4">
                    <children>
                        <Button mnemonicParsing="false" onAction="#aoAdicionar" styleClass="primario" text="Adicionar" />
                        <Button mnemonicParsing="false" onAction="#aoEditar" text="Salvar alterações" />
                        <Button mnemonicParsing="false" onAction="#aoAjustarEstoque" text="Ajustar estoque" />
                        <Button mnemonicParsing="false" onAction="#aoRemover" styleClass="perigo" text="Remover" />
                    </children>
                </HBox>
            </children>
        </GridPane>
    </bottom>
</BorderPane>
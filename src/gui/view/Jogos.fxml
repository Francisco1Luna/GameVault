<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.JogosController">
   <bottom>
      <VBox prefHeight="200.0" prefWidth="100.0" spacing="10.0" BorderPane.alignment="CENTER">
         <children>
            <HBox prefHeight="100.0" prefWidth="200.0">
               <children>
                  <TextField fx:id="campoTitulo" promptText="Título" />
                  <TextField fx:id="campoGenero" layoutX="10.0" layoutY="10.0" promptText="Gênero" />
               </children>
            </HBox>
            <HBox spacing="8.0">
               <children>
                  <ComboBox fx:id="comboClassificacao" prefWidth="160.0" promptText="Classificação" />
                  <ListView fx:id="listaPlataformas" prefHeight="62.0" prefWidth="160.0" />
                  <TextField fx:id="campoEstoque" promptText="Estoque por plataforma" />
               </children>
            </HBox>
            <HBox layoutX="10.0" layoutY="10.0" prefHeight="100.0" prefWidth="200.0" spacing="8.0">
               <children>
                  <TextField fx:id="campoPreco" promptText="Preço" />
                  <TextField fx:id="campoLocacao" promptText="Locação por dia" />
                  <Button mnemonicParsing="false" onAction="#aoAdicionar" text="Adicionar" />
                  <Button mnemonicParsing="false" onAction="#aoRemover" text="Remover" />
               </children>
            </HBox>
         </children>
      </VBox>
   </bottom>
   <center>
      <TableView fx:id="tabelaJogos" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
        <columns>
          <TableColumn fx:id="colId" prefWidth="38.0" text="ID" />
          <TableColumn fx:id="colTitulo" prefWidth="144.0" text="Título" />
            <TableColumn fx:id="colGenero" prefWidth="177.0" text="Gênero" />
            <TableColumn fx:id="colPreco" minWidth="6.0" prefWidth="103.0" text="Preço" />
            <TableColumn fx:id="colLocacao" prefWidth="100.0" text="Locação/dia" />
            <TableColumn fx:id="colPlataformas" prefWidth="140.0" text="Plataformas" />
        </columns>
      </TableView>
   </center>
</BorderPane>

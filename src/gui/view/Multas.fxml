<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Cabeçalho da tela + abas (pendentes / pagas), cada uma com uma barra de resumo embaixo -->
<VBox spacing="12.0" styleClass="tela" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.MultasController">
    <children>
        <VBox styleClass="cabecalho-tela">
            <children>
                <Label styleClass="titulo-tela" text="Multas" />
                <Label styleClass="subtitulo-tela" text="Multas geradas por atraso na devolução e seus pagamentos" />
            </children>
        </VBox>
        <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
            <tabs>
                <!-- Aba 1: Multas Pendentes -->
                <Tab text="Pendentes">
                    <content>
                        <BorderPane>
                            <center>
                                <TableView fx:id="tabelaMultas" BorderPane.alignment="CENTER">
                                    <placeholder><Label text="Nenhuma multa pendente" /></placeholder>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                    <columns>
                                        <TableColumn fx:id="colCliente" minWidth="60.0" prefWidth="200.0" reorderable="false" text="Cliente" />
                                        <TableColumn fx:id="colCpf" maxWidth="180.0" minWidth="60.0" prefWidth="140.0" reorderable="false" text="CPF" />
                                        <TableColumn fx:id="colJogo" minWidth="60.0" prefWidth="220.0" reorderable="false" text="Jogo" />
                                        <TableColumn fx:id="colGeracao" maxWidth="140.0" minWidth="60.0" prefWidth="110.0" reorderable="false" text="Gerada em" />
                                        <TableColumn fx:id="colValor" maxWidth="140.0" minWidth="60.0" prefWidth="110.0" reorderable="false" text="Valor" />
                                        <TableColumn fx:id="colSituacao" maxWidth="230.0" minWidth="60.0" prefWidth="180.0" reorderable="false" text="Situação" />
                                    </columns>
                                </TableView>
                            </center>
                            <bottom>
                                <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="card" BorderPane.alignment="CENTER">
                                    <BorderPane.margin><Insets top="12.0" /></BorderPane.margin>
                                    <children>
                                        <Label fx:id="rotuloTotal" maxWidth="Infinity" styleClass="resumo-valor" text="Total pendente: -" HBox.hgrow="ALWAYS" />
                                        <Button fx:id="botaoPagar" mnemonicParsing="false" onAction="#aoPagar" styleClass="primario" text="Registrar pagamento" />
                                    </children>
                                </HBox>
                            </bottom>
                        </BorderPane>
                    </content>
                </Tab>

                <!-- Aba 2: Multas Pagas -->
                <Tab text="Multas pagas">
                    <content>
                        <BorderPane>
                            <center>
                                <TableView fx:id="tabelaPagas" BorderPane.alignment="CENTER">
                                    <placeholder><Label text="Nenhuma multa paga ainda" /></placeholder>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                    <columns>
                                        <TableColumn fx:id="colClientePaga" minWidth="60.0" prefWidth="200.0" reorderable="false" text="Cliente" />
                                        <TableColumn fx:id="colCpfPaga" maxWidth="180.0" minWidth="60.0" prefWidth="140.0" reorderable="false" text="CPF" />
                                        <TableColumn fx:id="colJogoPaga" minWidth="60.0" prefWidth="220.0" reorderable="false" text="Jogo" />
                                        <TableColumn fx:id="colGeracaoPaga" maxWidth="140.0" minWidth="60.0" prefWidth="110.0" reorderable="false" text="Gerada em" />
                                        <TableColumn fx:id="colValorPaga" maxWidth="140.0" minWidth="60.0" prefWidth="110.0" reorderable="false" text="Valor" />
                                        <TableColumn fx:id="colPagaEm" maxWidth="140.0" minWidth="60.0" prefWidth="110.0" reorderable="false" text="Paga em" />
                                    </columns>
                                </TableView>
                            </center>
                            <bottom>
                                <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="card" BorderPane.alignment="CENTER">
                                    <BorderPane.margin><Insets top="12.0" /></BorderPane.margin>
                                    <children>
                                        <Label fx:id="rotuloTotalPago" maxWidth="Infinity" styleClass="resumo-valor" text="Total pago: -" HBox.hgrow="ALWAYS" />
                                    </children>
                                </HBox>
                            </bottom>
                        </BorderPane>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </children>
</VBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.MultasController">
    <center>
        <TableView fx:id="tabelaMultas" BorderPane.alignment="CENTER">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="colCliente" prefWidth="180.0" text="Cliente" />
                <TableColumn fx:id="colCpf" prefWidth="110.0" text="CPF" />
                <TableColumn fx:id="colJogo" prefWidth="180.0" text="Jogo" />
                <TableColumn fx:id="colGeracao" prefWidth="100.0" text="Gerada em" />
                <TableColumn fx:id="colValor" prefWidth="90.0" text="Valor" />
            </columns>
        </TableView>
    </center>
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="8.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
            </padding>
            <children>
                <Label fx:id="rotuloTotal" maxWidth="Infinity" text="Total pendente: -" HBox.hgrow="ALWAYS" />
                <Button mnemonicParsing="false" onAction="#aoPagar" text="Registrar pagamento" />
            </children>
        </HBox>
    </bottom>
</BorderPane>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.ClientesController">
    <center>
        <TableView fx:id="tabelaClientes" BorderPane.alignment="CENTER">
            <columns>
                <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
                <TableColumn fx:id="colNome" prefWidth="250.0" text="Nome" />
                <TableColumn fx:id="colCpf" prefWidth="150.0" text="CPF" />
            </columns>
        </TableView>
    </center>
    <bottom>
        <HBox spacing="8.0" BorderPane.alignment="CENTER">
            <children>
                <TextField fx:id="campoNome" promptText="Nome" />
                <TextField fx:id="campoCpf" promptText="CPF" />
                <Button mnemonicParsing="false" onAction="#aoRemover" text="Remover" />
            </children>
        </HBox>
    </bottom>
</BorderPane>